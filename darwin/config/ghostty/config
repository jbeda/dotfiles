# Ghostty config -- symlinked to ~/.config/ghostty/config by ./install.
# Reload in a running Ghostty with cmd+shift+, (or restart it).
#
# Note macOS also honors "$HOME/Library/Application Support/com.mitchellh.ghostty/config",
# loaded AFTER this file, so anything set there silently wins. Keep that one absent.

# Left Option sends Esc+key (Meta), so emacs-style M-w / M-b / M-f work in tmux
# copy mode and zsh line editing. Right Option keeps composing special
# characters (e.g. Option-8 for the bullet).
macos-option-as-alt = left

# Fonts -- kept in sync with editor.fontFamily / editor.fontWeight /
# editor.fontLigatures in VS Code's user settings on the Mac, so the terminal
# and the editor render identically. Change one, change the other.
#
# Install the *static* Monaspace build (monaspace-static-*.zip), not variable:
# the variable font has no `ital` axis yet, so italics come out as synthetic
# obliques rather than Xenon's designed slab italic. Nerd Font glyphs (used by
# the Claude Code statusline) need no patched font -- Ghostty bundles a
# Symbols Nerd Font fallback and size-matches it to the primary font.
#
# font-style matches the style name the *font* advertises, not a numeric
# weight. Verify the exact strings with: ghostty +list-fonts | grep -i xenon
font-family = Monaspace Xenon
font-style = ExtraLight
font-style-italic = ExtraLight Italic

# Bold inherits the family's Bold face, which is a long way from ExtraLight.
# Uncomment to pull it closer to the body text.
# font-style-bold = Regular
# font-style-bold-italic = Regular Italic

# Monaspace puts its coding ligatures in the stylistic sets, which are off by
# default; calt (texture healing), liga and dlig are on by default. So the
# sets have to be named explicitly, and dlig turned off -- it carries the
# typographic f-ligatures (fi, fl, ffi), which are single-advance and collapse
# a column in grid-less renderers like VS Code. Harmless in a terminal, but
# disabled here so both sides look the same.
font-feature = -dlig
font-feature = cv01=2
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10

# Theme -- Catppuccin Mocha, bundled with Ghostty (it ships the iterm2-color-
# schemes collection). The name is the theme's FILENAME, matched exactly --
# spaces and capitals included, so `catppuccin-mocha` does not resolve. A miss
# is not fatal: Ghostty logs "theme not found" and carries on with its default
# palette, so the only symptom is wrong colors. Verify with
# `ghostty +list-themes`, and check the whole file with
# `ghostty +validate-config --config-file=<path>` after editing.
#
# Kept in sync with the VS Code theme, tmux's status bar (link/.tmux.conf) and
# vivid's LS_COLORS (source/50_misc.sh), all Mocha. Starship needs no change:
# config/starship.toml names ANSI colors rather than hex, so it inherits
# whatever palette is set here.
theme = Catppuccin Mocha

# Mocha's own surfaces slid down one step, matching catppuccin.colorOverrides in
# VS Code: the editor/terminal field takes what was `mantle` (#181825) instead of
# `base` (#1e1e2e). Straight contrast, without brightening the foreground -- at
# ExtraLight, very bright thin strokes on a dark field start to halate. Applied
# after `theme` on purpose; later keys win.
background = #181825

# Floor on the contrast ratio between fg and bg (1-21). Rescues the color
# combinations programs pick for themselves -- dark blue on a dark field being
# the classic -- without touching pairs that are already legible. Kept low on
# purpose: crank it and it starts overriding the theme's actual colors.
minimum-contrast = 1.1

# Interpret colors in Display P3 rather than sRGB (macOS only). On a wide-gamut
# panel this pushes Mocha's accents noticeably richer. The tradeoff: the same
# hex renders differently here than in VS Code, so the two drift slightly apart
# despite both being Mocha. Drop back to `srgb` if that bothers you more than
# the extra saturation helps.
window-colorspace = display-p3

# --- Window ---------------------------------------------------------------
# Breathing room so text doesn't run into the window edge; balance spreads any
# leftover pixels across all four sides instead of piling them on one.
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true

# Themed title bar rather than the native gray slab sitting above a dark window.
# The proxy icon (cmd-click the title for the path) is worth keeping.
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = visible
