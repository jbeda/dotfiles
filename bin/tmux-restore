#!/bin/sh
# Restore the latest tmux-resurrect snapshot into a fresh default tmux server.
# Refusing a live server prevents the partial merge that a direct restore causes.
set -eu

restore_script="$HOME/src/dotfiles/third_party/tmux-resurrect/scripts/restore.sh"
resurrect_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"

if [ -n "${TMUX:-}" ]; then
  echo "tmux-restore: run this from a shell outside tmux" >&2
  exit 1
fi

if tmux list-sessions >/dev/null 2>&1; then
  echo "tmux-restore: a default tmux server is running; save and stop it first:" >&2
  echo "  tmux kill-server" >&2
  exit 1
fi

if [ ! -x "$restore_script" ] || [ ! -f "$resurrect_dir/last" ]; then
  echo "tmux-restore: no usable resurrect snapshot found" >&2
  exit 1
fi

tmux start-server
"$restore_script"

if ! tmux has-session -t main 2>/dev/null; then
  echo "tmux-restore: snapshot restored no main session" >&2
  exit 1
fi

exec tmux attach -t main
